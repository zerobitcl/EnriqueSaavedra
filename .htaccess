# Consilio — Estudio Jurídico | Hostinger Apache/LiteSpeed

# --- HTTPS estricto + no-www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://consilio.cl%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.consilio\.cl [NC]
  RewriteRule ^ https://consilio.cl%{REQUEST_URI} [L,R=301]

  # URLs "limpias" antiguas (404 en producción) → URLs reales indexables
  RewriteRule ^enrique-saavedra/?$ / [R=301,L]
  RewriteRule ^servicios/asesoria-legal-empresas/?$ /asesoria-legal-empresas.html [R=301,L]
  RewriteRule ^servicios/contratacion-comercial/?$ /contratacion-comercial.html [R=301,L]
  RewriteRule ^servicios/gestion-de-riesgos/?$ /gestion-de-riesgos.html [R=301,L]
  RewriteRule ^servicios/negociacion-comercial/?$ /negociacion-comercial.html [R=301,L]
</IfModule>

# Favicon: MIME correcto (Google + navegadores)
<IfModule mod_mime.c>
  AddType image/x-icon .ico
  AddType image/png .png
</IfModule>

# --- Compresión GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caché del navegador ---
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 year"

  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
