# Consilio — Estudio Jurídico | Hostinger Apache/LiteSpeed

# --- HTTPS estricto + no-www ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://consilio.cl%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.consilio\.cl [NC]
  RewriteRule ^ https://consilio.cl%{REQUEST_URI} [L,R=301]

  # --- URLs limpias (no requiere carpeta física /servicios/) ---

  # Redirigir .html y raíz a URLs canónicas
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ /enrique-saavedra [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+[\s?] [NC]
  RewriteRule ^$ /enrique-saavedra [R=301,L]

  RewriteCond %{THE_REQUEST} \s/asesoria-legal-empresas\.html[\s?] [NC]
  RewriteRule ^asesoria-legal-empresas\.html$ /servicios/asesoria-legal-empresas [R=301,L]

  RewriteCond %{THE_REQUEST} \s/contratacion-comercial\.html[\s?] [NC]
  RewriteRule ^contratacion-comercial\.html$ /servicios/contratacion-comercial [R=301,L]

  RewriteCond %{THE_REQUEST} \s/gestion-de-riesgos\.html[\s?] [NC]
  RewriteRule ^gestion-de-riesgos\.html$ /servicios/gestion-de-riesgos [R=301,L]

  RewriteCond %{THE_REQUEST} \s/negociacion-comercial\.html[\s?] [NC]
  RewriteRule ^negociacion-comercial\.html$ /servicios/negociacion-comercial [R=301,L]

  # Servir URLs limpias desde los archivos .html
  RewriteRule ^enrique-saavedra/?$ index.html [L]
  RewriteRule ^servicios/asesoria-legal-empresas/?$ asesoria-legal-empresas.html [L]
  RewriteRule ^servicios/contratacion-comercial/?$ contratacion-comercial.html [L]
  RewriteRule ^servicios/gestion-de-riesgos/?$ gestion-de-riesgos.html [L]
  RewriteRule ^servicios/negociacion-comercial/?$ negociacion-comercial.html [L]
</IfModule>

# --- Compresión GZIP ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Caché del navegador ---
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
